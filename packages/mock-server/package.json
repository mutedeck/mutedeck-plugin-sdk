{
  "name": "@mutedeck/mock-server",
  "version": "1.0.1",
  "description": "Programmable fake MuteDeck desktop (WebSocket v1/v2 and the HTTP API) for testing MuteDeck plugins",
  "license": "MIT",
  "author": "MuteDeck <support@mutedeck.com>",
  "homepage": "https://github.com/mutedeck/mutedeck-plugin-sdk/tree/main/packages/mock-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutedeck/mutedeck-plugin-sdk.git",
    "directory": "packages/mock-server"
  },
  "bugs": {
    "url": "https://github.com/mutedeck/mutedeck-plugin-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "mutedeck-mock-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}